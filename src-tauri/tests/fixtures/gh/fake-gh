#!/bin/sh
# A stand-in for the GitHub CLI in tests. It answers `gh api copilot_internal/user` and
# `gh api repos/<owner>/<name>/releases?per_page=100` the way the real gh does for the scenario named in the
# `scenario` file next to it, and fails on any other arguments. Each run's arguments are appended to `calls`.
# `gh release download <tag> --repo <repo> --pattern <name>... --dir <dir>` copies each named file that exists in
# the `assets` directory next to it into <dir>, and fails like gh when none of them does.
here=$(cd "$(dirname "$0")" && pwd)
scenario=$(cat "$here/scenario")
echo "$*" >> "$here/calls"

api="api --hostname github.com -H Accept: application/vnd.github+json -H X-GitHub-Api-Version: 2026-03-10"
case "$*" in
  "$api copilot_internal/user") answer="$here/copilot-user.json" ;;
  "$api repos/"*"/releases?per_page=100") answer="$here/releases.json" ;;
  "release download "*) answer=download ;;
  *)
    echo "fake gh: unexpected arguments: $*" >&2
    exit 64
    ;;
esac

case "$scenario" in
  ok)
    if [ "$answer" != download ]; then
      cat "$answer"
      exit 0
    fi
    shift 2
    dir="" patterns=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir) dir="$2"; shift 2 ;;
        --pattern) patterns="$patterns $2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$dir" ] || { echo "fake gh: no --dir" >&2; exit 64; }
    found=0
    for p in $patterns; do
      if [ -f "$here/assets/$p" ]; then
        cp "$here/assets/$p" "$dir/$p"
        found=1
      fi
    done
    [ $found -eq 1 ] || { echo "no assets match the file pattern" >&2; exit 1; }
    ;;
  signed-out)
    echo "To get started with GitHub CLI, please run:  gh auth login" >&2
    echo "Alternatively, populate the GH_TOKEN environment variable with a GitHub API authentication token." >&2
    exit 4
    ;;
  sso)
    echo '{"message":"Resource protected by organization SAML enforcement. You must grant your OAuth token access to this organization.","documentation_url":"https://docs.github.com/articles/authenticating-to-a-github-organization-with-saml-single-sign-on/","status":"403"}'
    echo "gh: Resource protected by organization SAML enforcement. You must grant your OAuth token access to this organization. (HTTP 403)" >&2
    exit 1
    ;;
  forbidden-mentioning-sso)
    echo '{"message":"Resource not accessible by integration. Ask an SSO admin to grant repository access.","status":"403"}'
    echo "gh: Resource not accessible by integration. Ask an SSO admin to grant repository access. (HTTP 403)" >&2
    exit 1
    ;;
  bad-credentials)
    echo '{"message":"Bad credentials","documentation_url":"https://docs.github.com/rest","status":"401"}'
    echo "gh: Bad credentials (HTTP 401)" >&2
    exit 1
    ;;
  server-error)
    echo '{"message":"Server Error"}'
    echo "gh: Server Error (HTTP 502)" >&2
    exit 1
    ;;
  offline)
    echo "error connecting to api.github.com" >&2
    echo "check your internet connection or https://githubstatus.com" >&2
    exit 1
    ;;
  *)
    echo "fake gh: unknown scenario $scenario" >&2
    exit 65
    ;;
esac
