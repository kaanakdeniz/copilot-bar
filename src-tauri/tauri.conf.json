{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopilotBar",
  "version": "../package.json",
  "identifier": "dev.copilotbar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "title": "CopilotBar",
        "url": "index.html?view=popover",
        "width": 340,
        "height": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "GitHub Copilot usage in your menu bar",
    "longDescription": "Track GitHub Copilot AI Credit usage per day, model and Project, and whether you are on pace for your Allowance.",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxQzdCQkM5NDdBMUE2QjkKUldTNXBxRkh5YnZIQVhPNlVMRWZ2STJ0STYvWk5kdXMyRTYvTndQSkE4cjlnS2hvYkRDbEY2UDYK"
    }
  }
}
